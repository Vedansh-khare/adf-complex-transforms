		{
			"name": "[concat(parameters('factoryName'), '/df_complex_transforms')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_customer",
								"type": "DatasetReference"
							},
							"name": "sourceCustomer"
						},
						{
							"dataset": {
								"referenceName": "ds_bronze_salesorderheader",
								"type": "DatasetReference"
							},
							"name": "sourceSalesOrderHeader"
						},
						{
							"dataset": {
								"referenceName": "ds_bronze_salesorderdetail",
								"type": "DatasetReference"
							},
							"name": "sourceSalesOrderDetail"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver_customer_metrics",
								"type": "DatasetReference"
							},
							"name": "sinkSilver"
						}
					],
					"transformations": [
						{
							"name": "joinCustOrders"
						},
						{
							"name": "joinOrderDetails"
						},
						{
							"name": "aggSalesMetrics"
						},
						{
							"name": "derivedMetrics"
						}
					],
					"scriptLines": [
						"source(output(",
						"          CustomerID as string,",
						"          PersonID as string,",
						"          StoreID as string,",
						"          TerritoryID as string,",
						"          AccountNumber as string,",
						"          rowguid as string,",
						"          ModifiedDate as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> sourceCustomer",
						"source(output(",
						"          SalesOrderID as integer,",
						"          RevisionNumber as string,",
						"          OrderDate as string,",
						"          DueDate as string,",
						"          ShipDate as string,",
						"          Status as string,",
						"          OnlineOrderFlag as string,",
						"          SalesOrderNumber as string,",
						"          PurchaseOrderNumber as string,",
						"          AccountNumber as string,",
						"          CustomerID as string,",
						"          SalesPersonID as string,",
						"          TerritoryID as string,",
						"          BillToAddressID as string,",
						"          ShipToAddressID as string,",
						"          ShipMethodID as string,",
						"          CreditCardID as string,",
						"          CreditCardApprovalCode as string,",
						"          CurrencyRateID as string,",
						"          SubTotal as string,",
						"          TaxAmt as string,",
						"          Freight as string,",
						"          TotalDue as string,",
						"          Comment as string,",
						"          rowguid as string,",
						"          ModifiedDate as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> sourceSalesOrderHeader",
						"source(output(",
						"          SalesOrderID as integer,",
						"          SalesOrderDetailID as string,",
						"          CarrierTrackingNumber as string,",
						"          OrderQty as string,",
						"          ProductID as string,",
						"          SpecialOfferID as string,",
						"          UnitPrice as string,",
						"          UnitPriceDiscount as string,",
						"          LineTotal as string,",
						"          rowguid as string,",
						"          ModifiedDate as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> sourceSalesOrderDetail",
						"sourceCustomer, sourceSalesOrderHeader join(sourceCustomer@CustomerID == sourceSalesOrderHeader@CustomerID,",
						"     joinType:'inner',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> joinCustOrders",
						"joinCustOrders, sourceSalesOrderDetail join(sourceSalesOrderHeader@SalesOrderID == sourceSalesOrderDetail@SalesOrderID,",
						"     joinType:'inner',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> joinOrderDetails",
						"joinOrderDetails aggregate(groupBy(sourceCustomer@CustomerID,",
						"          sourceCustomer@AccountNumber),",
						"     {Total order} = count(1),",
						"          {Total revenue} = sum(toDecimal(TotalDue, 10, 2))) ~> aggSalesMetrics",
						"aggSalesMetrics derive(AvgRevenuePerOrder = {Total revenue}/{Total order}) ~> derivedMetrics",
						"derivedMetrics sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkSilver"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_bronze_customer')]",
				"[concat(variables('factoryId'), '/datasets/ds_bronze_salesorderheader')]",
				"[concat(variables('factoryId'), '/datasets/ds_bronze_salesorderdetail')]",
				"[concat(variables('factoryId'), '/datasets/ds_silver_customer_metrics')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_transform')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_silver_salesorderheader",
								"type": "DatasetReference"
							},
							"name": "sourceSales"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_gold_salesorders",
								"type": "DatasetReference"
							},
							"name": "sinkGold"
						}
					],
					"transformations": [
						{
							"name": "RenameColumns"
						},
						{
							"name": "filterNulls"
						},
						{
							"name": "derivedColumn1"
						}
					],
					"scriptLines": [
						"source(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> sourceSales",
						"sourceSales select(skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> RenameColumns",
						"RenameColumns filter(true()) ~> filterNulls",
						"filterNulls derive(ingestion_date = currentDate(),",
						"          source_system = 'ADF') ~> derivedColumn1",
						"derivedColumn1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkGold"
					]
				}
